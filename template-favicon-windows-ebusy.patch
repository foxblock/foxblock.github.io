# Fix Windows EBUSY build errors by sharing one in-flight favicon generation per build.
# Reset the promise before rebuilds and regenerate files even after dist is cleaned.
# Initially applied to Digital Garden template version 1.91.0.

diff --git a/.eleventy.js b/.eleventy.js
--- a/.eleventy.js
+++ b/.eleventy.js
@@ -847,7 +847,9 @@ module.exports = function(eleventyConfig) {
   eleventyConfig.addPassthroughCopy("src/site/scripts");
   eleventyConfig.addPassthroughCopy("src/site/styles/_theme.*.css");
   eleventyConfig.addPassthroughCopy({ "src/site/logo.*": "/" });
+  let faviconPromise;
   eleventyConfig.on("eleventy.before", () => {
+    faviconPromise = undefined;
     normalizeFavicon(FAVICON_SOURCE, FAVICON_NORMALIZED);
     anchorAttributesCache.clear();
   });
@@ -860,7 +862,18 @@ module.exports = function(eleventyConfig) {
     }
   });
   eleventyConfig.addWatchTarget(FAVICON_SOURCE);
-  eleventyConfig.addPlugin(faviconsPlugin, { outputDir: "dist" });
+  // All pages share one favicon. Cache the in-flight promise as well as its HTML
+  // so parallel templates cannot write the same files (EBUSY on Windows).
+  faviconsPlugin({
+    addAsyncShortcode(name, generate) {
+      eleventyConfig.addAsyncShortcode(name, function () {
+        faviconPromise ??= Promise.resolve().then(() => generate.call(this,
+          FAVICON_NORMALIZED, { appleIconBgColor: "#123" }));
+        return faviconPromise;
+      });
+    },
+  // Our per-build cache owns reuse; regenerate even if dist was cleaned.
+  }, { outputDir: "dist", skipCache: true });
   eleventyConfig.addPlugin(tocPlugin, {
     ul: true,
     tags: ["h1", "h2", "h3", "h4", "h5", "h6"],
diff --git a/src/site/_includes/components/pageheader.njk b/src/site/_includes/components/pageheader.njk
--- a/src/site/_includes/components/pageheader.njk
+++ b/src/site/_includes/components/pageheader.njk
@@ -58,7 +58,7 @@
 <script defer src="{{script}}?v={{meta.buildDate|isoDate}}"></script>
 {%- endfor -%}
 
-{% favicons './.cache/favicon.normalized.svg', appleIconBgColor='#123' %}
+{% favicons %}
 
 {% if meta.styleSettingsCss %}
     <style>
