{
  "version": 1,
  "plugins": {
    "dg-filetree": {
      "enabled": false
    },
    "personal-navbar": {
      "enabled": true
    },
    "dg-timestamps": {
      "settings": {
        "showCreated": true,
        "showUpdated": true,
        "position": "top",
        "showOnHome": false,
        "timestampFormat": "MMM dd, yyyy h:mm a",
        "dateFormat": "MMM dd, yyyy"
      }
    }
  }
}