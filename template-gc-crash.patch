# Fix Eleventy startup GC crash: "FATAL ERROR: CALL_AND_RETRY_LAST Allocation failed - JavaScript heap out of memory" (watch:eleventy exits with 134).
# Import markdown-it-mathjax3 through its ESM entry to bypass the blocking CommonJS deasync bridge.
# Await Markdown plugin hooks before user setup and rendering; include a fresh-process regression test.
# Only necessary because we upgraded the mathjax3 plugin from 4.X to 5.X
# Adapted for 1.96.0: fresh-process regression test already exists; retain it unchanged.
# Initially applied to Digital Garden template version 1.91.0.

diff --git a/.eleventy.js b/.eleventy.js
--- a/.eleventy.js
+++ b/.eleventy.js
@@ -236,7 +236,7 @@ const tagRegex = /(^|\s|\>)(#[^\s!@#$%^&*()=+\.,\[{\]};:'"?><]+)(?!([^<]*>))/g;
 const markdownFileTypeRegex = /\.(md|markdown)$/i;
 const isMarkdownPage = (inputPath) => inputPath && inputPath.match(markdownFileTypeRegex);
 
-module.exports = function(eleventyConfig) {
+module.exports = async function(eleventyConfig) {
   eleventyConfig.setLiquidOptions({
     dynamicPartials: true,
   });
@@ -459,9 +459,11 @@ module.exports = function(eleventyConfig) {
 
         return defaultLinkRule(tokens, idx, options, env, self);
       };
-    })
-    .use((md) => pluginLoader.applyMarkdownHooks(md))
-    .use(userMarkdownSetup);
+    });
+
+  // Markdown-it.use is synchronous; await plugin imports before user setup.
+  await pluginLoader.applyMarkdownHooks(markdownLib);
+  markdownLib.use(userMarkdownSetup);
 
   eleventyConfig.setLibrary("md", markdownLib);
 
diff --git a/src/helpers/pluginLoader.js b/src/helpers/pluginLoader.js
index 863dfd35..7eca2930 100644
--- a/src/helpers/pluginLoader.js
+++ b/src/helpers/pluginLoader.js
@@ -329,13 +329,13 @@ function requireHooks(plugin) {
   }
 }
 
-/** Called from .eleventy.js as the last markdown-it .use() before userMarkdownSetup. */
-function applyMarkdownHooks(md, options) {
+/** Await Markdown hooks in order before userMarkdownSetup and rendering. */
+async function applyMarkdownHooks(md, options) {
   for (const plugin of enabledPlugins(options)) {
     const hooks = requireHooks(plugin);
     if (!hooks || typeof hooks.setupMarkdown !== "function") continue;
     try {
-      hooks.setupMarkdown(md, hookContext(plugin));
+      await hooks.setupMarkdown(md, hookContext(plugin));
     } catch (error) {
       warn(`${plugin.id}: setupMarkdown failed (${error.message}); skipping it`);
     }
diff --git a/src/plugins/dg-math/index.js b/src/plugins/dg-math/index.js
index 621c8bf9..cacd674d 100644
--- a/src/plugins/dg-math/index.js
+++ b/src/plugins/dg-math/index.js
@@ -1,6 +1,8 @@
 module.exports = {
-  setupMarkdown(md) {
-    md.use(require("markdown-it-mathjax3"), {
+  async setupMarkdown(md) {
+    // Its CommonJS entry uses deasync, which exhausts the heap during async startup.
+    const { default: mathjaxPlugin } = await import("markdown-it-mathjax3");
+    md.use(mathjaxPlugin, {
       tex: {
         inlineMath: [["$", "$"]],
       },
